{
	admin off
	auto_https off
	persist_config off
	servers {
		# Keep Railway's X-Forwarded-Proto (https) so Neo4j advertises https URLs.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT} {
	# Health check: Neo4j's discovery document answers 200 without login.
	handle /healthz {
		rewrite * /
		reverse_proxy 127.0.0.1:7474 {
			header_up Accept application/json
		}
	}

	# Bolt over WebSocket (used by Neo4j Browser and browser drivers).
	@bolt {
		header_regexp Connection (?i)upgrade
		header_regexp Upgrade (?i)websocket
	}
	handle @bolt {
		reverse_proxy 127.0.0.1:7687
	}

	# Everything else: Neo4j Browser and the HTTP API.
	handle {
		reverse_proxy 127.0.0.1:7474
	}
}
